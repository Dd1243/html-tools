# Cloudflare Pages headers
# https://developers.cloudflare.com/pages/configuration/headers/
#
# 注意：_headers 的规则按「请求路径」匹配。本站使用无扩展名 URL
# （如 /tools/dev/json-formatter），所以规则必须写成 /tools/*；
# 写成 /tools/*.html 这类带后缀的规则在干净 URL 上不会命中。
#
# 缓存策略：
#   HTML     —— 浏览器每次校验（max-age=0），边缘缓存 1 小时，过期后先回旧内容再后台刷新
#   静态资源 —— 浏览器 1 天，边缘 1 天，后台刷新
#   图标     —— 7 天
# 部署后如需立即生效，在 Cloudflare 后台 Purge Everything。

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

# ============================================
# HTML：允许边缘缓存（按真实路径匹配）
# ============================================
/
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/tools/*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/guides/*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/tools-directory
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/templates/*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/design-templates/*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/design-reference/*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/about
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/contact
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/privacy-policy
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/terms
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/*.html
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

# ============================================
# 静态资源：长缓存 + 后台刷新
# ============================================
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/screenshots/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.png
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

/*.ico
  Cache-Control: public, max-age=604800

# ============================================
# 索引文件
# ============================================
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=600, s-maxage=3600, stale-while-revalidate=86400

/sitemap.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=600, s-maxage=3600, stale-while-revalidate=86400

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=600, s-maxage=3600, stale-while-revalidate=86400

/manifest.json
  Cache-Control: public, max-age=600, s-maxage=3600, stale-while-revalidate=86400

/llms.txt
  Cache-Control: public, max-age=600, s-maxage=3600, stale-while-revalidate=86400
