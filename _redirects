# Cloudflare Pages / Netlify redirects
# https://developers.cloudflare.com/pages/platform/redirects

# Baidu verification file - prevent automatic .html stripping
/baidu_verify_codeva-L08oitvCVO  /baidu_verify_codeva-L08oitvCVO.html  200

# Redirect old tool path to new
/tool/*  /tools/:splat  301

# Note: Root-level .html pages (tools-directory, privacy-policy, etc.)
# do NOT need explicit rules. Cloudflare Pages native pretty URLs
# automatically handles:
#   /tools-directory       → serve tools-directory.html (200)
#   /tools-directory.html  → 301 → /tools-directory
#   /tools-directory/      → 301 → /tools-directory
# Adding manual _redirects rules conflicts and causes redirect loops.

# Guides (article system, flat under /guides/)
/guides  /guides/index.html  200
/guides/  /guides/index.html  200
# Legacy category paths → flat URLs
/guides/dev  /guides/  301
/guides/dev/  /guides/  301
/guides/dev/json-formatter-guide  /guides/json-formatter-guide  301
/guides/dev/json-formatter-guide.html  /guides/json-formatter-guide  301

# Catch-all: old site URLs (pre-WebUtils era, e-commerce / blog URLs like
# /cotton-silk-dupatta, /sephora-collection-contour-eye-pencil, etc.) all
# return 404 currently, wasting Google's crawl budget. We redirect all unknown
# paths to homepage with 301 so Google stops crawling dead URLs and passes any
# remaining link equity to the current site.
# Note: Cloudflare Pages serves static assets (sitemap.xml, robots.txt,
# favicon.svg, /assets/*) BEFORE evaluating _redirects, so they are unaffected.
# Existing rules above (/tool/*, /guides/*, etc.) match first for valid pages.
/*  /  301
